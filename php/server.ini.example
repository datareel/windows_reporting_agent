; DataReel Reporting Agent server settings
;
; Copy to /etc/windows_reporting_agent/server.ini, or set the
; WRA_SERVER_INI environment variable in the web server to another path.
; Keep this file outside the web root: it holds the enrollment token.
;
;   Apache: SetEnv WRA_SERVER_INI /path/to/server.ini

[paths]
; Where accepted reports are written, one file per host
; (<hostname>_windows_report_agent.txt). bash/run_windows_laptop_inventory.sh
; reads this directory.
reports_dir = /var/www/html/windows/reports
; Agent registrations and replay protection data. Must be writable by the
; web server user and should be outside the web root.
data_dir = /var/lib/windows_reporting_agent

[registration]
; Shared secret that agents send when they register (enrollment_token in
; the agent INI file). Leave empty to require an admin to approve every
; agent on admin.php.
enrollment_token =
; 1 = approve an agent automatically when its enrollment token matches
; 0 = the token is still checked, but an admin must approve the agent
auto_approve_with_token = 1

[upload]
; Largest report accepted, in bytes
max_upload_bytes = 2000000
; Largest difference allowed between the agent clock and the server
; clock, in seconds. Signed requests outside this window are rejected.
max_clock_skew_seconds = 300

[admin]
; 1 = admin.php only runs behind web server authentication (it needs
; REMOTE_USER, for example from Apache AuthType Basic). Only set this to 0
; if access to admin.php is restricted some other way.
require_remote_user = 1
; basic = the web server login above (.htaccess AuthType Basic)
; drsm  = the DataReel System Monitor dashboard login. The pages must be
;         under the dashboard's web folder, for example
;         /dashboard/windows/upload, so they share its session cookie.
login = basic
; With login = drsm: the dashboard's config/drsm.php, absolute or relative
; to the pages folder, for example ../../config/drsm.php
drsm_config =

[status]
; Rules for status.php, the fleet status page
; A report older than this is late (warning)
late_hours = 24
; A report older than this is missing (error)
missing_days = 15
; Warn when the newest Windows cumulative or security update is older
; than this, counted from the report time
patch_max_age_days = 45
; Programs every computer must have, comma separated, * and ? wildcards
; required_apps = "Microsoft 365 Apps*, Google Chrome"
required_apps =
; Computers the required_apps check skips, for example servers
; required_apps_skip_hosts = "srv-*"
required_apps_skip_hosts =
; Programs no computer should have
; unwanted_apps = "uTorrent*, CCleaner*"
unwanted_apps =
; 1 = status.php and report.php need no login. Only for a demo with
; sample data: the reports are an inventory of your computers.
public = 0
; Measure report ages from this time instead of now: an epoch time, or
; "fleet" for the time in reports_dir/fleet.json (gen_sample_fleet.py)
reference_time =
